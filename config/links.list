# Dotfile collegati da install.sh con link simbolici, uno per riga:
# <file nel repository> <destinazione relativa a $HOME>
# Esempio: config/foot/foot.ini .config/foot/foot.ini
# Gli item successivi aggiungono qui i propri dotfile.
systemd/weston.service .config/systemd/user/weston.service
systemd/start-session.sh .local/libexec/my-pixel-11-pro-desktop/start-session
config/hypr/hyprland.lua .config/hypr/hyprland.lua
config/waybar/config.jsonc .config/waybar/config.jsonc
config/waybar/style.css .config/waybar/style.css
config/foot/foot.ini .config/foot/foot.ini
config/fuzzel/fuzzel.ini .config/fuzzel/fuzzel.ini
config/hypr/hyprpaper.conf .config/hypr/hyprpaper.conf
config/hypr/hyprlock.conf .config/hypr/hyprlock.conf
config/hypr/wallpaper.png .config/hypr/wallpaper.png
config/mako/config .config/mako/config
